      "parentId": "page:rzZiePRRfcB3TrrCNiMbE",
      "index": "a3veI",
      "typeName": "shape"
    },
    "shape:U5Vc3MwFGZ96a6f_nH7X4": {
      "x": 392,
      "y": 24,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:U5Vc3MwFGZ96a6f_nH7X4",
      "type": "gap",
      "parentId": "shape:xvsQDoxDWtBU84iENlxRn",
      "props": {
        "w": 320,
        "h": 200,
        "label": "The ledger, once emptied, simply closes for the day.",
        "facingId": "shape:kV5DBjmx7LAzqeZ8ja2N2",
        "sourceId": "g-r-002"
      },
      "index": "a5U0e",
      "typeName": "shape"
    },
    "shape:pOgghCeTmTisM9gjFLpmq": {
      "x": -600,
      "y": 744,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:pOgghCeTmTisM9gjFLpmq",
      "type": "atom",
      "props": {
        "w": 320,
        "h": 200,
        "atom": "untyped",
        "text": "I grant this much of the received view: something is indeed spent when I attend, some capacity narrows under steady use, and the evening mind is not the morning mind.",
        "sourceId": "004-the-concession",
        "created": "2026-07-31",
        "ordinal": 4
      },
      "parentId": "page:rzZiePRRfcB3TrrCNiMbE",
      "index": "a75hb",
      "typeName": "shape"
    },
