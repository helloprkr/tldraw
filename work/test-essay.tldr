      "type": "frame",
      "props": {
        "w": 784,
        "h": 1040,
        "name": "Mine",
        "color": "black"
      },
      "parentId": "page:rzZiePRRfcB3TrrCNiMbE",
      "index": "a2pzUV",
      "typeName": "shape"
    },
    "shape:xSETlMmKeFjZ9EeVsWkif": {
      "x": 24,
      "y": 768,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:xSETlMmKeFjZ9EeVsWkif",
      "type": "gap",
      "parentId": "shape:m_JQs1vh7ev7ZFEm4X4p1",
      "props": {
        "w": 320,
        "h": 200,
        "label": "The scarce good is time, and attention is how time is spent.",
        "facingId": "shape:nVvqKlxN4TRfGTwAtnu0v",
        "sourceId": "g-r-007"
      },
      "index": "aDBsI",
      "typeName": "shape"
    },
    "shape:v7-Ts9YBd5J286BoY2M_S": {
      "x": 392,
      "y": 24,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:v7-Ts9YBd5J286BoY2M_S",
      "type": "atom",
      "parentId": "shape:m_JQs1vh7ev7ZFEm4X4p1",
      "props": {
        "w": 320,
        "h": 200,
        "atom": "stance",
        "text": "The ledger, once emptied, simply closes for the day.",
        "sourceId": "r-002",
        "created": "2026-07-31",
        "ordinal": 2
      },
      "index": "a2CUa",
      "typeName": "shape"
    },
    "binding:YXsol0dtjqvvXdBg5Pdp8": {
      "meta": {},
      "id": "binding:YXsol0dtjqvvXdBg5Pdp8",
      "type": "arrow",
      "fromId": "shape:4ITibj9qBlqUk-nqdzhpL",
      "toId": "shape:Gyu4lpEnHnvSXkD86lRby",
      "props": {
