    },
    "shape:8DPp92e2PS_jbLflCX9VP": {
      "x": 392,
      "y": 272,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:8DPp92e2PS_jbLflCX9VP",
      "type": "atom",
      "parentId": "shape:m_JQs1vh7ev7ZFEm4X4p1",
      "props": {
        "w": 320,
        "h": 200,
        "atom": "stance",
        "text": "A mind spread thin produces thin noticing.",
        "sourceId": "r-004",
        "created": "2026-07-31",
        "ordinal": 4
      },
      "index": "a4Igz",
      "typeName": "shape"
    },
    "shape:OrypP3apbvLqca33-xLSd": {
