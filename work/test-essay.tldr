    "page:page": {
      "meta": {},
      "id": "page:page",
      "name": "Page 1",
      "index": "a1",
      "typeName": "page"
    },
    "document:document": {
      "gridSize": 10,
      "name": "",
      "meta": {},
      "id": "document:document",
      "typeName": "document"
    },
    "shape:5QEbM6zOTTCvmWLnCuJe6": {
      "x": 405.0501903187276,
      "y": 290.94096272159703,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:5QEbM6zOTTCvmWLnCuJe6",
      "type": "atom",
      "props": {
        "w": 320,
        "h": 200,
        "atom": "untyped",
        "text": "But a resource, once spent, is gone—while attention, oddly, comes back changed rather than emptied, the way a stomach does not vanish after a meal but sets to work on what it was given.",
        "sourceId": "005-the-turn",
        "created": "2026-07-30",
        "ordinal": 5
      },
      "parentId": "shape:NrfEUK3ihwKQcQ7AYYYqI",
      "index": "a53er",
      "typeName": "shape"
    },
    "shape:Sc8Xe6pnwhIecKVfS4g5G": {
      "x": 37.05019031872757,
      "y": 290.94096272159703,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:Sc8Xe6pnwhIecKVfS4g5G",
      "type": "atom",
      "props": {
        "w": 320,
        "h": 200,
        "atom": "untyped",
        "text": "I grant this much of the received view: something is indeed spent when I attend, some capacity narrows under steady use, and the evening mind is not the morning mind.",
        "sourceId": "004-the-concession",
        "created": "2026-07-30",
        "ordinal": 4
      },
      "parentId": "shape:NrfEUK3ihwKQcQ7AYYYqI",
      "index": "a4lNU",
      "typeName": "shape"
    },
    "shape:c8znXl8aD82hkYysJ8gCW": {
      "x": 24,
      "y": 520,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:c8znXl8aD82hkYysJ8gCW",
      "type": "atom",
      "parentId": "shape:m_JQs1vh7ev7ZFEm4X4p1",
      "props": {
        "w": 320,
        "h": 200,
        "atom": "stance",
        "text": "Focus is a muscle, and the remedy for weakness is repetition.",
        "sourceId": "r-005",
        "created": "2026-07-31",
        "ordinal": 5
      },
      "index": "a5cwb",
      "typeName": "shape"
    },
    "shape:JG98tOuH9r-ApCdVBp_55": {
      "x": 736,
      "y": 992,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:JG98tOuH9r-ApCdVBp_55",
      "type": "atom",
      "props": {
        "w": 320,
        "h": 200,
        "atom": "untyped",
        "text": "2026-07-26 — open question for the seam: what is the attention-equivalent of malnutrition? Not distraction, which is too flat a word—something closer to a diet of fragments that never gets broken down into anything a practice can hold.",
        "sourceId": "notes-3",
        "created": "2026-07-30",
        "ordinal": 15
      },
      "parentId": "page:page",
      "index": "aU8Hj",
      "typeName": "shape"
    },
    "shape:NrfEUK3ihwKQcQ7AYYYqI": {
      "x": -40,
      "y": -40,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:NrfEUK3ihwKQcQ7AYYYqI",
      "type": "frame",
      "props": {
        "w": 1120,
        "h": 540,
        "name": "Ground",
        "color": "black"
      },
      "parentId": "page:page",
      "index": "aV6Lb",
      "typeName": "shape"
    },
    "shape:awHZLatQiABijvqPvaWyG": {
      "x": 392,
      "y": 1016,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:awHZLatQiABijvqPvaWyG",
      "type": "gap",
      "parentId": "shape:m_JQs1vh7ev7ZFEm4X4p1",
      "props": {
        "w": 320,
        "h": 200,
        "label": "The cure for a distracted age is a stricter accounting.",
        "facingId": "shape:pa36m_ZsWZ4b7GtU8NjlW",
        "sourceId": "g-r-010"
      },
      "index": "aGyFM",
      "typeName": "shape"
    },
    "shape:szFOcsItC8ZPVBL_XbOJ0": {
      "x": 760,
      "y": 296,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:szFOcsItC8ZPVBL_XbOJ0",
      "type": "atom",
      "props": {
        "w": 320,
        "h": 200,
        "atom": "untyped",
        "text": "This is the seam I want to work: not spending but metabolizing, not depletion but digestion, and the difference is not decorative—it changes what discipline is for.",
        "sourceId": "006-the-seam",
        "created": "2026-07-30",
        "ordinal": 6
      },
      "parentId": "shape:NrfEUK3ihwKQcQ7AYYYqI",
      "index": "a6O6M",
      "typeName": "shape"
    },
    "binding:RwWV6aZuzweANoa_WXFra": {
      "meta": {},
      "id": "binding:RwWV6aZuzweANoa_WXFra",
      "type": "arrow",
      "fromId": "shape:4ITibj9qBlqUk-nqdzhpL",
      "toId": "shape:GE9tKRRi9zwqN5e6gCdFe",
      "props": {
        "isPrecise": false,
        "isExact": false,
        "normalizedAnchor": {
          "x": 0.5,
          "y": 0.5
        },
        "snap": "none",
        "terminal": "end"
      },
      "typeName": "binding"
    },
    "shape:6ixsFzTpt0mhZWKH7kJAr": {
      "x": 760,
      "y": 48,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:6ixsFzTpt0mhZWKH7kJAr",
      "type": "atom",
      "props": {
        "w": 320,
        "h": 200,
        "atom": "untyped",
        "text": "Attention is not spent. It is fed.",
        "sourceId": "009-fed-not-spent",
        "created": "2026-07-30",
        "ordinal": 9
      },
      "parentId": "shape:OrypP3apbvLqca33-xLSd",
      "index": "a3VRv",
      "typeName": "shape"
    }
