        "w": 1120,
        "h": 540,
        "name": "The seam",
        "color": "black"
      },
      "parentId": "page:page",
      "index": "aWblr",
      "typeName": "shape"
    },
    "shape:YkbTQeNKsOaCg8zIw08aE": {
      "x": 24,
      "y": 24,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:YkbTQeNKsOaCg8zIw08aE",
      "type": "atom",
      "parentId": "shape:qSBVHYUr_ji9QkO3ClHZd",
      "props": {
        "w": 320,
        "h": 200,
        "atom": "claim",
        "text": "Picture the gut, not the wallet: a patient organ that cares what it is asked to break down.",
        "sourceId": "m-001",
        "created": "2026-07-31",
        "ordinal": 1
      },
      "index": "a1LbQ",
      "typeName": "shape"
    },
    "shape:4ITibj9qBlqUk-nqdzhpL": {
      "x": 13.050190318727573,
      "y": -5.059037278402968,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:4ITibj9qBlqUk-nqdzhpL",
      "type": "arrow",
      "props": {
        "kind": "arc",
        "elbowMidPoint": 0.5,
        "dash": "solid",
        "size": "s",
        "fill": "fill",
        "color": "black",
        "labelColor": "black",
        "bend": 0,
        "start": {
          "x": 0,
